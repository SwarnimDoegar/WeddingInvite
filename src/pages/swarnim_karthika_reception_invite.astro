---
import InviteLayout from "../layouts/InviteLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import CoupleHeader from "../components/CoupleHeader.astro";
import RsvpForm from "../components/RsvpForm.astro";

// TODO: replace with groom-side reception video/thumbnail once uploaded to ImageKit
const videoBase =
  "https://ik.imagekit.io/pwliscd3n/minraws/Dummy/swarnim_karthika_reception_invite.mp4";
---

<InviteLayout
  title="Swarnim & Karthika | Reception"
  description="TODO: groom-side reception invite description (families, date, venue)."
  ogTitle="Swarnim & Karthika's Reception"
  ogDescription="TODO: groom-side reception invite description"
  ogImage={`${videoBase}/ik-thumbnail.jpg?tr=so-1,w-1080`}
  ogVideo={`${videoBase}?tr=so-0,du-15,w-720,h-1280,q-70,f-mp4,vc-h264,ac-aac`}
  favicon="favicon-sk.ico"
>
  <VideoHero
    videoDesktop={`${videoBase}?tr=w-1080,q-80,f-auto`}
    videoMobile={`${videoBase}?tr=w-720,q-75,f-auto`}
    poster={`${videoBase}/ik-thumbnail.jpg?tr=so-1,w-1080`}
  />
  <section class="rsvp-panel" id="rsvp">
    <CoupleHeader
      tagline="TODO: tagline for groom-side reception invite"
      partnerA="Swarnim"
      partnerB="Karthika"
      date="TODO: date"
      venue="TODO: venue"
    />
    <RsvpForm />
  </section>
</InviteLayout>
