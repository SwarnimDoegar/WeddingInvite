---
import InviteLayout from "../layouts/InviteLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import CoupleHeader from "../components/CoupleHeader.astro";
import RsvpForm from "../components/RsvpForm.astro";

const videoBase =
  "https://ik.imagekit.io/pwliscd3n/minraws/Dummy/swarnim_karthika_reception_invite.mp4";
// Bump whenever a file in public/assets changes, so returning
// guests get the new stylesheet/scripts instead of a cached copy.
const VERSION = "1";
---

<InviteLayout
  title="Swarnim & Karthika | Reception, 13th December 2026"
  description="Together with our families, we invite you to celebrate the wedding reception of Swarnim & Karthika — 13th December 2026, Zirakpur."
  ogTitle="Swarnim & Karthika's Reception"
  ogDescription="Together with our families, we invite you to an evening of celebration — 13th December 2026, Zirakpur"
  ogImage={`${videoBase}/ik-thumbnail.jpg?tr=so-2,w-1080`}
  ogVideo={`${videoBase}?tr=so-0,du-15,w-1080,q-80,f-mp4,vc-h264,ac-aac`}
  favicon="favicon-sk.ico"
  sealImage="seal-sk.svg"
  version={VERSION}
>
  <VideoHero
    videoDesktop={`${videoBase}?tr=w-1080,q-80,f-auto`}
    videoMobile={`${videoBase}?tr=w-720,q-75,f-auto`}
    poster={`${videoBase}/ik-thumbnail.jpg?tr=so-1,w-1080`}
  />
  <section class="rsvp-panel" id="rsvp">
    <CoupleHeader
      tagline="Together with our families, we invite you to an evening of celebration"
      partnerA="Swarnim"
      partnerB="Karthika"
      receptionVenue="Zirakpur"
      receptionVenueUrl="https://maps.app.goo.gl/SxewuuaCzsfhE5539"
      receptionDate="13th December, 2026"
    />
    <RsvpForm
      formAction="https://docs.google.com/forms/d/e/1FAIpQLSeiHrPU7zsWpt9mS7_0VZXksjuzx2UaDaEdRPX0xI8ZUfGWEA/formResponse"
      nameField="entry.1612042241"
      attendingField="entry.1306605310"
      guestsField="entry.375165308"
      phoneField="entry.224335856"
    />
  </section>
</InviteLayout>
