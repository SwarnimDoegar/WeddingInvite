---
import InviteLayout from "../layouts/InviteLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import CoupleHeader from "../components/CoupleHeader.astro";
import RsvpForm from "../components/RsvpForm.astro";

const videoBase =
  "https://ik.imagekit.io/pwliscd3n/minraws/Dummy/swarnim_karthika_wedding_invite.mp4";
// Bump after re-uploading a video at the same ImageKit path. The URL is
// otherwise identical, so the CDN - and WhatsApp, which caches a link's
// preview on first share - would keep serving the old cut.
const VERSION = "3";
---

<InviteLayout
  title="Swarnim & Karthika | 6th December 2026"
  description="We invite you to celebrate the wedding of Swarnim & Karthika - 6th December 2026, Thiruvananthapuram."
  ogTitle="Swarnim & Karthika's Wedding Invitation"
  ogDescription="We invite you to celebrate our son's wedding - 6th December 2026, Thiruvananthapuram"
  ogImage={`${videoBase}/ik-thumbnail.jpg?tr=so-2,w-1080&v=${VERSION}`}
  ogVideo={`${videoBase}?tr=so-0,du-15,w-1080,q-80,f-mp4,vc-h264,ac-aac&v=${VERSION}`}
  favicon="favicon-sk.ico"
  sealImage="seal-sk.svg"
>
  <VideoHero
    videoDesktop={`${videoBase}?tr=w-1080,q-80,f-auto&v=${VERSION}`}
    videoMobile={`${videoBase}?tr=w-720,q-75,f-auto&v=${VERSION}`}
    poster={`${videoBase}/ik-thumbnail.jpg?tr=so-2,w-1080&v=${VERSION}`}
    sealImage="seal-sk.svg"
  />
  <section class="rsvp-panel" id="rsvp">
    <CoupleHeader
      tagline="Naresh and Vijay invite you to celebrate the wedding of their beloved son"
      partnerA="Swarnim"
      partnerB="Karthika"
      partnerJoiner="with"
      weddingVenue="Thiruvananthapuram"
      weddingVenueUrl="https://maps.app.goo.gl/x7rRoYgLqCKp5BkH9"
      weddingDate="6th December, 2026"
      receptionVenue="Zirakpur"
      receptionVenueUrl="https://maps.app.goo.gl/SxewuuaCzsfhE5539"
      receptionDate="13th December, 2026"
      stayVenue="Archrose Villa"
      stayVenueUrl="https://www.google.com/maps/dir//Archrose+Villa,+19+A,+Mythri+Nagar,+Kazhakkoottam,+Thiruvananthapuram,+Keralam+695582/@8.564377,76.869108,13z/data=!4m20!1m10!3m9!1s0x3b05bf14371f1b65:0x36ff87218aff53bb!2sArchrose+Villa!5m2!4m1!1i2!8m2!3d8.5633589!4d76.8721982!16s%2Fg%2F11nsyth6zk!4m8!1m0!1m5!1m1!1s0x3b05bf14371f1b65:0x36ff87218aff53bb!2m2!1d76.8721874!2d8.5634007!3e0?hl=en&entry=ttu&g_ep=EgoyMDI2MDkyMi4wIKXMDSoASAFQAw%3D%3D"
    />
    <RsvpForm
      formAction="https://docs.google.com/forms/d/e/1FAIpQLScsnZi9OQTCS2fsgEnhJH_GdyoHPJOyl41y1rLPrRFcLWCriQ/formResponse"
      nameField="entry.1612042241"
      attendingField="entry.1306605310"
      guestsField="entry.375165308"
      phoneField="entry.224335856"
    />
  </section>
</InviteLayout>
