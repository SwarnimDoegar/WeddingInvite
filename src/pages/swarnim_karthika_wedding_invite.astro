---
import InviteLayout from "../layouts/InviteLayout.astro";
import VideoHero from "../components/VideoHero.astro";
import CoupleHeader from "../components/CoupleHeader.astro";
import RsvpForm from "../components/RsvpForm.astro";

// TODO: replace with groom-side wedding video/thumbnail once uploaded to ImageKit
const videoBase =
  "https://ik.imagekit.io/pwliscd3n/minraws/Dummy/swarnim_karthika_wedding_invite.mp4";
// Bump after re-uploading a video at the same ImageKit path. The URL is
// otherwise identical, so the CDN — and WhatsApp, which caches a link's
// preview on first share — would keep serving the old cut.
const VERSION = "1";
---

<InviteLayout
  title="Swarnim & Karthika | Wedding"
  description="TODO: groom-side wedding invite description (families, date, venue)."
  ogTitle="Swarnim & Karthika's Wedding"
  ogDescription="TODO: groom-side wedding invite description"
  ogImage={`${videoBase}/ik-thumbnail.jpg?tr=so-2,w-1080&v=${VERSION}`}
  ogVideo={`${videoBase}?tr=so-0,du-15,w-1080,q-80,f-mp4,vc-h264,ac-aac&v=${VERSION}`}
  favicon="favicon-sk.ico"
  sealImage="seal-sk.svg"
>
  <VideoHero
    videoDesktop={`${videoBase}?tr=w-1080,q-80,f-auto&v=${VERSION}`}
    videoMobile={`${videoBase}?tr=w-720,q-75,f-auto&v=${VERSION}`}
    poster={`${videoBase}/ik-thumbnail.jpg?tr=so-2,w-1080&v=${VERSION}`}
  />
  <section class="rsvp-panel" id="rsvp">
    <CoupleHeader
      tagline="TODO: tagline for groom-side wedding invite"
      partnerA="Swarnim"
      partnerB="Karthika"
      weddingVenue="Thiruvananthapuram"
      weddingVenueUrl="https://maps.app.goo.gl/x7rRoYgLqCKp5BkH9"
      weddingDate="6th December, 2026"
      receptionVenue="Zirakpur"
      receptionVenueUrl="https://maps.app.goo.gl/SxewuuaCzsfhE5539"
      receptionDate="13th December, 2026"
    />
    <RsvpForm
      formAction="TODO: groom-side wedding Google Form /formResponse URL"
      nameField="TODO: entry.XXXXXXX"
      attendingField="TODO: entry.XXXXXXX"
      guestsField="TODO: entry.XXXXXXX"
      phoneField="TODO: entry.XXXXXXX"
    />
  </section>
</InviteLayout>
