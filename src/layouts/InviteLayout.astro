---
import EnvelopeGate from "../components/EnvelopeGate.astro";

interface Props {
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  ogImage: string;
  ogVideo: string;
  ogVideoWidth?: number;
  ogVideoHeight?: number;
  favicon: string;
  sealImage: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogVideo,
  // Must match what the og:video transform actually delivers (w-1080 on a
  // 9:16 source), not the source's own dimensions.
  ogVideoWidth = 1080,
  ogVideoHeight = 1920,
  favicon,
  sealImage,
} = Astro.props;

// BASE_URL can end with a slash ("/" in dev) or not if a base path is ever
// configured again, so strip any trailing slash before joining.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const asset = (file: string) => `${base}/assets/${file}`;
---

<!doctype html>
<html lang="en" class="envelope-active">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="theme-color" content="#241A12" />
    <link rel="icon" href={asset(favicon)} sizes="any" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / WhatsApp link preview -->
    <meta property="og:type" content="video.other" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:video" content={ogVideo} />
    <meta property="og:video:secure_url" content={ogVideo} />
    <meta property="og:video:type" content="video/mp4" />
    <meta property="og:video:width" content={ogVideoWidth} />
    <meta property="og:video:height" content={ogVideoHeight} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={asset("hero.css")} />
  </head>
  <body class="envelope-active">
    <EnvelopeGate sealImage={sealImage} />

    <div class="page">
      <slot />
      <!-- Mobile only: stacked layout pushes the form below the video, so
           this jumps down to it. A plain anchor rather than a scripted
           button, so it still works if the script never runs. It lives
           inside .page to inherit the gate's reveal - position: fixed
           takes it out of the flex flow, so it doesn't disturb layout. -->
      <a class="rsvp-cta" href="#rsvp">RSVP</a>
    </div>

    <script is:inline src={asset("envelope.js")}></script>
    <script is:inline src={asset("hero.js")}></script>
    <script is:inline src={asset("rsvp.js")}></script>
  </body>
</html>
