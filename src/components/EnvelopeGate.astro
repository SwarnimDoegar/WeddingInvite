---
import Seal from "./Seal.astro";

interface Props {
  sealImage: string;
}

const { sealImage } = Astro.props;
---

<div class="envelope-gate" id="envelopeGate">
  <div class="envelope">
    <span class="envelope__body"></span>
    <span class="envelope__flap-wrap">
      <span class="envelope__flap"></span>
      <Seal sealImage={sealImage} class="envelope__seal" />
    </span>
    <!-- Full-size overlay button: makes the whole envelope clickable with
         real button semantics/keyboard support, while keeping the animated
         flap and seal markup free of nested interactive elements. -->
    <button
      class="envelope__hit-area"
      id="envelopeTrigger"
      type="button"
      aria-label="Open the invitation"
    ></button>
  </div>
  <p class="envelope__prompt">Tap to open</p>
</div>
